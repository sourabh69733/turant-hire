DEBUG=true

# Supabase project URL and keys are optional for now unless you want to use
# Supabase Auth / Storage APIs directly. The backend primarily needs the
# Postgres connection string below.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Preferred: direct Postgres connection string from Supabase.
# Example format:
# postgresql+psycopg://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Optional local-only fallback if you want to run without Supabase:
# DATABASE_URL=sqlite:///./turant_hire.db
